{
  "manifest_version": 3,
  "name": "Recall Capture",
  "version": "0.1.0",
  "description": "Capture and organize web resources with Recall.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to Recall"
  },
  "background": {
  "service_worker": "background/background.js",
  "type": "module"
}
}